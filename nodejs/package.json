{
    "name": "copilot-sdk-supercharged",
    "repository": {
        "type": "git",
        "url": "https://github.com/jeremiahjordanisaacson/copilot-sdk-supercharged.git"
    },
    "version": "3.0.0",
    "copilotCliVersion": "1.0.113",
    "description": "GitHub Copilot SDK Supercharged - TypeScript SDK for programmatic control of GitHub Copilot CLI via JSON-RPC. Supports 40 languages.",
    "main": "./dist/cjs/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./extension": {
            "import": {
                "types": "./dist/extension.d.ts",
                "default": "./dist/extension.js"
            },
            "require": {
                "types": "./dist/extension.d.ts",
                "default": "./dist/cjs/extension.js"
            }
        }
    },
    "type": "module",
    "scripts": {
        "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});for(const f of fs.readdirSync('.'))if(f.endsWith('.tgz'))fs.rmSync(f)\"",
        "build": "tsx esbuild-copilotsdk-nodejs.ts",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "github",
        "copilot",
        "sdk",
        "jsonrpc",
        "agent",
        "supercharged",
        "ai",
        "llm",
        "tools"
    ],
    "author": "jeremiahjordanisaacson",
    "license": "MIT",
    "dependencies": {
        "koffi": "3.3.7",
        "lossless-json": "4.3.3",
        "vscode-jsonrpc": "10.0.0",
        "zod": "4.6.7"
    },
    "optionalDependencies": {
        "@microsoft/copilot-sdk-darwin-arm64": "2.0.0",
        "@microsoft/copilot-sdk-darwin-x64": "2.0.0",
        "@microsoft/copilot-sdk-linux-arm64": "2.0.0",
        "@microsoft/copilot-sdk-linux-x64": "2.0.0",
        "@microsoft/copilot-sdk-linuxmusl-arm64": "2.0.0",
        "@microsoft/copilot-sdk-linuxmusl-x64": "2.0.0",
        "@microsoft/copilot-sdk-win32-arm64": "2.0.0",
        "@microsoft/copilot-sdk-win32-x64": "2.0.0"
    },
    "devDependencies": {
        "@github/copilot": "1.0.113",
        "@types/node": "^25.6.0",
        "esbuild": "^0.28.1",
        "tsx": "^4.20.6",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "files": [
        "dist/**/*",
        "!dist/tsconfig.tsbuildinfo",
        "docs/**/*",
        "README.md"
    ]
}
